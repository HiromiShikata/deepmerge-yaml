{
  "name": "deepmerge-yaml",
  "version": "0.0.1",
  "description": "deep merge yaml",
  "keywords": [
    "typescript",
    "yaml",
    "merge",
    "deepmerge",
    "cli",
    "bin"
  ],
  "bugs": {
    "url": "https://github.com/kahirokunn/deepmerge-yaml/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahirokunn/deepmerge-yaml.git"
  },
  "license": "MIT",
  "author": "kahirokunn",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.js",
  "bin": "lib/bin/deepmerge-yaml.js",
  "files": [
    "lib",
    "esm"
  ],
  "scripts": {
    "build": "npm run cleanup && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json && chmod +x ./lib/bin/deepmerge-yaml.js",
    "build:esm": "tsc -p tsconfig.esm.json && chmod +x ./esm/bin/deepmerge-yaml.js",
    "cleanup": "rm -rf lib esm",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.{js,jsx,ts,tsx}' --max-warnings=0",
    "lint:fix": "npm run prettier && npx eslint --fix",
    "prepublishOnly": "npm run build",
    "prettier": "prettier '**/*.{js,jsx,ts,tsx,json}' --write",
    "test": "jest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "dependencies": {
    "commander": "^13.1.0",
    "deepmerge": "^4.2.2",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/commander": "2.12.5",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "babel-jest": "30.5.2",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "56.0.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "sort-package-json": "4.0.0",
    "ts-node": "10.9.2",
    "type-fest": "5.10.0",
    "typescript": "6.0.3"
  }
}
